#!/bin/bash

COMPATIBLE=false

# Modo compatible desde machine.conf (seccion [11] de tmux.conf): si definí
# "set -g @mytmux_compatible true", usamos texto plano. El flag --compatible
# por linea de comandos sigue funcionando igual.
if [ "$(tmux show-option -gv @mytmux_compatible 2>/dev/null)" = "true" ]; then
    COMPATIBLE=true
fi

for arg in "$@"; do
    case "$arg" in
        --compatible) COMPATIBLE=true ;;
    esac
done

if $COMPATIBLE; then
    ON="SOUND ON"
    OFF="SOUND OFF"
else
    ON="🕪"
    OFF="🕨"
fi

status=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
volume=$(echo "$status" | awk '{print $2}')

case "$status" in
    *MUTED*)
        echo "$OFF"
        ;;
    "Volume: 0.00")
        echo "$OFF"
        ;;
    *)
        echo "$ON"
        ;;
esac
